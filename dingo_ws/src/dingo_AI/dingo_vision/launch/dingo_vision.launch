<launch>
    <arg name="is_sim" default="0"/>
    <arg name="is_physical" default="1"/>
    <arg name="use_joystick" default="0"/>
    <arg name="use_keyboard" default="0"/>
    <arg name="serial_port" default="/dev/ttyS0"/>
    <arg name="use_imu" default="0"/>

    <arg name="control_cpu" default="0,1,2,3" doc="CPU cores reserved for timing-sensitive control nodes."/>
    <arg name="vision_cpu" default="0,1,2,3" doc="CPU cores for camera, tracker, keyboard, joystick, and other non-control nodes."/>

    <arg name="use_camera" default="1"/>
    <arg name="camera_backend" default="gscam_nodelet" doc="python_gst is stable on Jetson; gscam_nodelet keeps the nodelet path available for debugging."/>
    <arg name="use_tracker" default="1"/>
    <arg name="tracker_method" default="yolo_nodelet" doc="ML_algos uses the existing OpenCV/optical-flow tracker. yolo uses TensorRT YOLO tracking. yolo_nodelet loads the TensorRT tracker as a nodelet."/>
    <arg name="tracker_type" default="KCF"/>
    <arg name="tracker_show_window" default="0"/>
    <arg name="tracker_interactive_roi" default="0"/>
    <arg name="tracker_selection_mode" default="bbox" doc="bbox selects a box ROI, point_bbox clicks a point then creates a small ROI for KCF/MIL, optical_flow tracks one clicked point with Lucas-Kanade."/>
    <arg name="tracker_point_roi_size" default="40"/>
    <arg name="tracker_lk_win_size" default="21"/>
    <arg name="tracker_lk_max_level" default="3"/>
    <arg name="tracker_max_width" default="640"/>
    <arg name="plot_frequency" default="100"/>

    <arg name="use_follow" default="1"/>
    <arg name="follow_enabled" default="1"/>
    <arg name="follow_lock_delay" default="10.0"/>
    <arg name="follow_command_rate" default="4.0"/>
    <arg name="follow_center_deadband_ratio" default="0.15"/>
    <arg name="follow_distance_deadband_ratio" default="0.12"/>
    <arg name="follow_yaw_gain" default="0.55"/>
    <arg name="follow_max_yaw_cmd" default="1.5"/>
    <arg name="follow_area_gain" default="4.0"/>
    <arg name="follow_target_height_ratio" default="0.8"/>
    <arg name="follow_target_area_ratio" default="0.4"/>
    <arg name="follow_step_scale" default="10.0"/>
    <arg name="follow_max_steps" default="50"/>
    <arg name="follow_min_command_interval" default="1.0"/>
    <arg name="follow_smooth_alpha" default="0.35"/>
    <arg name="follow_enable_appearance_reacquire" default="1"/>
    <arg name="follow_appearance_match_threshold" default="0.55"/>
    <arg name="follow_appearance_update_alpha" default="0.03"/>
    <arg name="follow_joy_topic" default="joy"/>
    <arg name="follow_joy_rate_hz" default="30.0"/>
    <arg name="follow_linear_axis_value" default="0.5"/>
    <arg name="follow_step_duration" default="0.35"/>
    <arg name="follow_yaw_duration" default="0.45"/>
    <arg name="follow_button_pulse_duration" default="0.18"/>
    <arg name="follow_yaw_axis_sign" default="-1.0"/>
    <arg name="follow_yaw_axis_scale" default="5"/>
    <arg name="follow_return_to_rest_after_command" default="1"/>
    <arg name="follow_publish_debug_info" default="0"/>

    <arg name="yolo_model_path" default="/dingo_ws/src/dingo_AI/yolox/models/yolov8n.engine"/>
    <arg name="yolo_export_pt_path" default="/dingo_ws/src/dingo_AI/yolox/models/yolov8n.pt"/>
    <arg name="yolo_export_engine_if_missing" default="0"/>
    <arg name="yolo_tracking_backend" default="iou" doc="C++ TensorRT node currently supports iou; Python Ultralytics wrapper previously used bytetrack/botsort."/>
    <arg name="yolo_classes" default="0" doc="0 tracks person only. Use all for all classes, or comma-separated class ids."/>
    <arg name="yolo_conf" default="0.25"/>
    <arg name="yolo_iou" default="0.7"/>
    <arg name="yolo_imgsz" default="640"/>
    <arg name="yolo_device" default="0"/>
    <arg name="yolo_half" default="1"/>
    <arg name="yolo_publish_debug_image" default="0"/>

    <arg name="camera_width" default="360"/>
    <arg name="camera_height" default="300"/>
    <arg name="camera_fps" default="10"/>
    <arg name="camera_sensor_id" default="0"/>
    <arg name="camera_flip_method" default="0"/>
    <arg name="camera_frame_id" default="gscam_nodelet"/>

    <group if="$(eval arg('use_camera') and arg('camera_backend') == 'gscam_nodelet')">
        <node pkg="nodelet" type="nodelet" name="camera_nodelet_manager" args="manager" launch-prefix="taskset -c $(arg vision_cpu)" output="screen"/>

        <node pkg="nodelet" type="nodelet" name="gscam_csi_camera"
              args="load gscam/GSCamNodelet camera_nodelet_manager" launch-prefix="taskset -c $(arg vision_cpu)" output="screen">
            <param name="camera_name" value="dingo_csi_camera"/>
            <param name="camera_info_url" value="package://gscam/examples/uncalibrated_parameters.ini"/>
            <param name="gscam_config" value="nvarguscamerasrc sensor-id=$(arg camera_sensor_id) ! video/x-raw(memory:NVMM),width=$(arg camera_width),height=$(arg camera_height),format=NV12,framerate=$(arg camera_fps)/1 ! nvvidconv flip-method=$(arg camera_flip_method) ! video/x-raw,format=BGRx ! videoconvert ! video/x-raw,format=RGB"/>
            <param name="frame_id" value="$(arg camera_frame_id)"/>
            <param name="image_encoding" value="rgb8"/>
            <param name="sync_sink" value="false"/>
        </node>
    </group>

    <group if="$(eval arg('use_camera') and arg('camera_backend') == 'python_gst')">
        <node pkg="dingo_vision" type="run_ros_gst_camera.sh" name="dingo_csi_camera" launch-prefix="taskset -c $(arg vision_cpu)" output="screen">
            <param name="sensor_id" type="int" value="$(arg camera_sensor_id)"/>
            <param name="width" type="int" value="$(arg camera_width)"/>
            <param name="height" type="int" value="$(arg camera_height)"/>
            <param name="fps" type="int" value="$(arg camera_fps)"/>
            <param name="flip_method" type="int" value="$(arg camera_flip_method)"/>
            <param name="frame_id" value="$(arg camera_frame_id)"/>
            <param name="image_topic" value="/camera/image_raw"/>
            <param name="camera_info_topic" value="/camera/camera_info"/>
        </node>
    </group>



    <!-- <group if="$(eval arg('use_tracker') and arg('tracker_method') == 'ML_algos')">
        <node pkg="dingo_vision" type="run_ros_image_tracker.sh" name="vision_tracker" launch-prefix="taskset -c $(arg vision_cpu)" output="screen">
            <param name="image_topic" value="/camera/image_raw"/>
            <param name="tracker_type" value="$(arg tracker_type)"/>
            <param name="show_window" type="bool" value="$(arg tracker_show_window)"/>
            <param name="interactive_roi" type="bool" value="$(arg tracker_interactive_roi)"/>
            <param name="selection_mode" value="$(arg tracker_selection_mode)"/>
            <param name="point_roi_size" type="int" value="$(arg tracker_point_roi_size)"/>
            <param name="lk_win_size" type="int" value="$(arg tracker_lk_win_size)"/>
            <param name="lk_max_level" type="int" value="$(arg tracker_lk_max_level)"/>
            <param name="max_width" type="int" value="$(arg tracker_max_width)"/>
            <param name="publish_debug_image" type="bool" value="0"/>
        </node>
    </group> -->


    <!-- <group if="$(eval arg('use_tracker') and arg('tracker_method') == 'yolo')">
        <node pkg="yolox" type="yolo_trt_node" name="yolo_tracker" launch-prefix="env LD_LIBRARY_PATH=/host_cuda/targets/aarch64-linux/lib:/host_cuda/lib64:/usr/lib/aarch64-linux-gnu/tegra:/usr/lib/aarch64-linux-gnu/tegra-egl:/dingo_ws/devel/lib:/opt/ros/noetic/lib:$LD_LIBRARY_PATH taskset -c $(arg vision_cpu)" output="screen">
            <param name="image_topic" value="/camera/image_raw"/>
            <param name="model_path" value="$(arg yolo_model_path)"/>
            <param name="export_pt_path" value="$(arg yolo_export_pt_path)"/>
            <param name="export_engine_if_missing" type="bool" value="$(arg yolo_export_engine_if_missing)"/>
            <param name="tracking_backend" value="$(arg yolo_tracking_backend)"/>
            <param name="classes" type="int" value="$(arg yolo_classes)"/>
            <param name="conf" type="double" value="$(arg yolo_conf)"/>
            <param name="iou" type="double" value="$(arg yolo_iou)"/>
            <param name="imgsz" type="int" value="$(arg yolo_imgsz)"/>
            <param name="device" value="$(arg yolo_device)"/>
            <param name="half" type="bool" value="$(arg yolo_half)"/>
            <param name="max_width" type="int" value="$(arg tracker_max_width)"/>
            <param name="show_window" type="bool" value="$(arg tracker_show_window)"/>
            <param name="publish_debug_image" type="bool" value="$(arg yolo_publish_debug_image)"/>
        </node>
    </group> -->

    <group if="$(eval arg('use_tracker') and arg('tracker_method') == 'yolo_nodelet' and arg('camera_backend') == 'gscam_nodelet')">
        <node pkg="nodelet" type="nodelet" name="yolo_tracker" args="load yolox/YoloTrtNodelet camera_nodelet_manager" launch-prefix="env LD_LIBRARY_PATH=/host_cuda/targets/aarch64-linux/lib:/host_cuda/lib64:/usr/lib/aarch64-linux-gnu/tegra:/usr/lib/aarch64-linux-gnu/tegra-egl:/dingo_ws/devel/lib:/opt/ros/noetic/lib:$LD_LIBRARY_PATH taskset -c $(arg vision_cpu)" output="screen">
            <param name="image_topic" value="/camera/image_raw"/>
            <param name="model_path" value="$(arg yolo_model_path)"/>
            <param name="tracking_backend" value="$(arg yolo_tracking_backend)"/>
            <param name="classes" type="int" value="$(arg yolo_classes)"/>
            <param name="conf" type="double" value="$(arg yolo_conf)"/>
            <param name="iou" type="double" value="$(arg yolo_iou)"/>
            <param name="max_width" type="int" value="$(arg tracker_max_width)"/>
            <param name="publish_debug_image" type="bool" value="$(arg yolo_publish_debug_image)"/>
        </node>
    </group>




    <group if="$(arg use_follow)">
        <node pkg="follow" type="person_follow_node.py" name="person_follow" launch-prefix="taskset -c $(arg vision_cpu)" output="screen">
            <param name="tracks_topic" value="/yolo_tracker/tracks"/>
            <param name="enabled" type="bool" value="$(arg follow_enabled)"/>
            <param name="image_topic" value="/camera/image_raw"/>
            <param name="image_width" type="double" value="$(arg camera_width)"/>
            <param name="image_height" type="double" value="$(arg camera_height)"/>
            <param name="lock_delay" type="double" value="$(arg follow_lock_delay)"/>
            <param name="command_rate" type="double" value="$(arg follow_command_rate)"/>
            <param name="center_deadband_ratio" type="double" value="$(arg follow_center_deadband_ratio)"/>
            <param name="distance_deadband_ratio" type="double" value="$(arg follow_distance_deadband_ratio)"/>
            <param name="yaw_gain" type="double" value="$(arg follow_yaw_gain)"/>
            <param name="max_yaw_cmd" type="double" value="$(arg follow_max_yaw_cmd)"/>
            <param name="area_gain" type="double" value="$(arg follow_area_gain)"/>
            <param name="target_height_ratio" type="double" value="$(arg follow_target_height_ratio)"/>
            <param name="target_area_ratio" type="double" value="$(arg follow_target_area_ratio)"/>
            <param name="step_scale" type="double" value="$(arg follow_step_scale)"/>
            <param name="max_steps" type="int" value="$(arg follow_max_steps)"/>
            <param name="min_command_interval" type="double" value="$(arg follow_min_command_interval)"/>
            <param name="smooth_alpha" type="double" value="$(arg follow_smooth_alpha)"/>
            <param name="enable_appearance_reacquire" type="bool" value="$(arg follow_enable_appearance_reacquire)"/>
            <param name="appearance_match_threshold" type="double" value="$(arg follow_appearance_match_threshold)"/>
            <param name="appearance_update_alpha" type="double" value="$(arg follow_appearance_update_alpha)"/>
            <param name="joy_topic" value="$(arg follow_joy_topic)"/>
            <param name="joy_rate_hz" type="double" value="$(arg follow_joy_rate_hz)"/>
            <param name="linear_axis_value" type="double" value="$(arg follow_linear_axis_value)"/>
            <param name="step_duration" type="double" value="$(arg follow_step_duration)"/>
            <param name="yaw_duration" type="double" value="$(arg follow_yaw_duration)"/>
            <param name="button_pulse_duration" type="double" value="$(arg follow_button_pulse_duration)"/>
            <param name="yaw_axis_sign" type="double" value="$(arg follow_yaw_axis_sign)"/>
            <param name="yaw_axis_scale" type="double" value="$(arg follow_yaw_axis_scale)"/>
            <param name="return_to_rest_after_command" type="bool" value="$(arg follow_return_to_rest_after_command)"/>
            <param name="publish_debug_info" type="bool" value="$(arg follow_publish_debug_info)"/>
        </node>
    </group>

    <group if="$(arg use_joystick)">
        <node pkg="joy" type="joy_node" name="JOYSTICK" launch-prefix="taskset -c $(arg vision_cpu)">
            <param name="autorepeat_rate" value="30"/>
        </node>
    </group>

    <group if="$(arg use_keyboard)">
        <node pkg="dingo_input_interfacing" type="Keyboard.py" name="keyboard_input_listener" launch-prefix="taskset -c $(arg vision_cpu)" output="screen"/>
    </group>

    <node pkg="dingo" type="dingo_driver.py"
          name="dingo" args="$(arg is_sim) $(arg is_physical) $(arg use_imu)" launch-prefix="taskset -c $(arg control_cpu)" output="screen"/>
</launch>
